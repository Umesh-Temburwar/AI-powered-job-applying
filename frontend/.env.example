# ==============================================================================
# UNIVERSAL JOB APPLY BOT — FRONTEND ENVIRONMENT TEMPLATE
# ==============================================================================
# Copy this file to .env or .env.local
# DO NOT put sensitive backend secrets or GitHub Client Secrets here!
#
# Authentication Notes:
# 1. Email & Password authentication uses Supabase Auth directly.
# 2. GitHub OAuth authentication uses Supabase as the OAuth Broker.
#    GitHub Client ID & Secret must be configured in the Supabase Dashboard,
#    NEVER in this frontend configuration.
# ==============================================================================

# Supabase Project Credentials (Publishable/Anon Key Only)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Backend FastAPI URL
VITE_API_BASE_URL=http://localhost:8000
