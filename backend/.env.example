# Application Configuration
APP_NAME=Universal Job Apply Bot API
ENVIRONMENT=development
DEBUG=false
API_V1_PREFIX=/api/v1

# Allowed CORS Origins (comma-separated list for local and production Vercel frontend)
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://universal-job-apply-bot.vercel.app

# Supabase Authentication & Database
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
# Server-only credentials (Never expose to frontend/browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_SECRET_KEY=your-server-side-secret-key-here
SUPABASE_JWT_SECRET=your-jwt-secret-here

