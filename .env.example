# ==============================================================================
# UNIVERSAL AUTO-APPLY BOT CONFIGURATION (TEMPLATE)
# Copy this file to .env and fill in your details
# NEVER commit .env to git (it's protected in .gitignore)
# ==============================================================================

# --- Personal Details ---
FIRSTNAME=YourFirstName
LASTNAME=YourLastName
PHONE=+919876543210

# --- Search Preferences ---
KEYWORDS=full stack developer, react developer, node.js developer, web developer, software engineer
LOCATION=pune
PAGES_PER_KEYWORD=2
MAX_APPLICATIONS=50

# --- Career & Screening Preferences ---
TOTAL_EXPERIENCE_YEARS=0
RELEVANT_EXPERIENCE_YEARS=1
CURRENT_CTC=0 (Fresher)
EXPECTED_CTC=4.5 Lakhs
NOTICE_PERIOD=Immediate (0 Days)
WORK_MODE=Remote / Hybrid
WILLING_TO_RELOCATE=Yes
GENDER=Male

# --- Highest Education ---
EDUCATION_DEGREE=Bachelor of Technology (B.Tech)
EDUCATION_COLLEGE=Your College Name
EDUCATION_PASSING_YEAR=2025
EDUCATION_SCORE=7.5 CGPA

# --- Online Profiles & Portfolio ---
LINKEDIN_URL=https://linkedin.com/in/yourprofile
GITHUB_URL=https://github.com/yourusername
PORTFOLIO_URL=https://yourportfolio.app

# --- Browser Choice (auto, edge, chrome, brave, firefox) ---
BROWSER=auto

# ==============================================================================
# PLATFORM CREDENTIALS
# ==============================================================================

# 1. NAUKRI.COM
NAUKRI_EMAIL=your_email@example.com
NAUKRI_PASSWORD=your_naukri_password

# 2. INTERNSHALA.COM
INTERNSHALA_EMAIL=your_email@example.com
INTERNSHALA_PASSWORD=your_internshala_password

# 3. INDEED.COM
INDEED_EMAIL=your_email@example.com
INDEED_PASSWORD=your_indeed_password

# 4. LINKEDIN.COM
LINKEDIN_EMAIL=your_email@example.com
LINKEDIN_PASSWORD=your_linkedin_password

# ==============================================================================
# REAL-TIME NOTIFICATIONS & AI (OPTIONAL)
# ==============================================================================
# Telegram Bot instant smartphone alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Discord Webhook channel notifications
DISCORD_WEBHOOK_URL=

# AI Screening Question Generator (Gemini Flash - Free Tier)
# If blank, the bot uses its built-in offline NLP heuristic answerer
GEMINI_API_KEY=

# Local Web Dashboard Port (Default: 5000)
DASHBOARD_PORT=5000

//   npm run dev -- --host 0.0.0.0   Same Wifi Coneect Other Devices Access Command 