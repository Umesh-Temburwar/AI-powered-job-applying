# ==============================================================================
# UNIVERSAL AUTO-APPLY BOT CONFIGURATION (TEMPLATE)
# Copy this file to .env and fill in your details
# NEVER commit .env to git (it's protected in .gitignore)
# ==============================================================================

# --- Personal Details ---
FIRSTNAME=YourFirstName
LASTNAME=YourLastName
PHONE=+919876543210

# --- Search Preferences ---
KEYWORDS=full stack developer, react developer, node.js developer, web developer, software engineer
LOCATION=pune
PAGES_PER_KEYWORD=2
MAX_APPLICATIONS=50

# --- Browser Choice (auto, edge, chrome, brave, firefox) ---
BROWSER=auto

# ==============================================================================
# PLATFORM CREDENTIALS
# ==============================================================================

# 1. NAUKRI.COM
NAUKRI_EMAIL=your_email@example.com
NAUKRI_PASSWORD=your_naukri_password

# 2. INTERNSHALA.COM
INTERNSHALA_EMAIL=your_email@example.com
INTERNSHALA_PASSWORD=your_internshala_password

# 3. INDEED.COM
INDEED_EMAIL=your_email@example.com
INDEED_PASSWORD=your_indeed_password

# 4. LINKEDIN.COM
LINKEDIN_EMAIL=your_email@example.com
LINKEDIN_PASSWORD=your_linkedin_password

# --- Optional Paths ---
# EDGE_DRIVER_PATH=
# CHROME_DRIVER_PATH=